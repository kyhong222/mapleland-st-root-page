{
  "name": "mapleland-st-root",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://mapleland.st/",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
